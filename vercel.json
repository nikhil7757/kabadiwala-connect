{
  "version": 2,
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
